[Unit]
Description=MPK/Weather Data Harvester
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__HARVESTER_DIR__
ExecStart=__HARVESTER_DIR__/.venv/bin/python scheduler.py
Restart=on-failure
RestartSec=30
Environment=DATABASE_URL=postgresql://mpk:mpk@localhost:5432/mpk_harvester

[Install]
WantedBy=multi-user.target